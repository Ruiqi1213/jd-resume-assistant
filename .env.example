# 文案模型（生成招呼语 / 侧重点 / 结构化解析，OpenAI 兼容接口）
# 方案A（推荐，一套硅基流动 key 全搞定）：BASE_URL=https://api.siliconflow.cn/v1，MODEL=deepseek-ai/DeepSeek-V3.2
# 方案B（DeepSeek 官方）：BASE_URL=https://api.deepseek.com/v1，MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3.2

# 视觉模型（JD 截图识别，兼容 OpenAI 格式，如硅基流动）
VISION_API_KEY=
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 每小时每 IP 调用上限（extract + generate 合计）
RATE_LIMIT_PER_HOUR=20

# 访问口令：设置后任何人访问都必须先输入此口令（留空=不启用门槛，仅本地开发用）
# 部署到公网时务必设置一个随机字符串，例如用 openssl rand -hex 16 生成
ACCESS_CODE=

# 可选：Upstash Redis（Vercel 等 serverless 部署时让限流跨实例共享）
# 在 https://console.upstash.com 免费创建 Redis 后填入；留空则退化为进程内存限流
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
